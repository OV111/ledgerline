# Copy this file to .env and change values if you want.
# .env is ignored by git. Never commit real secrets.
POSTGRES_USER=ledgerline
POSTGRES_PASSWORD=ledgerline
POSTGRES_DB=ledgerline

# Ledgerline's ports on your computer. They avoid the common defaults
# (5432, 8080, 5173) so they don't clash with other projects.
#   8090  API
#   5440  PostgreSQL (docker compose)
#   5441  throwaway PostgreSQL for tests (see README)
#   5180  web dev server (set in web/vite.config.ts)
API_PORT=8090
DB_PORT=5440
